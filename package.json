{
	"name": "rookdex",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"check": "astro check",
		"format": "biome format --write .",
		"icons": "pwa-assets-generator",
		"icons:favicon": "pwa-assets-generator --config pwa-assets.config.favicon.ts && node -e \"require('node:fs').renameSync('assets/favicon.ico', 'public/favicon.ico')\"",
		"lint": "biome lint .",
		"preview": "wrangler dev",
		"test": "vitest run",
		"typecheck": "astro check",
		"deploy:check": "astro build && wrangler deploy --dry-run"
	},
	"dependencies": {
		"@astrojs/markdown-satteri": "0.4.5",
		"@astrojs/react": "7.1.1",
		"@fontsource-variable/dm-sans": "5.3.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource/bebas-neue": "5.3.0",
		"astro": "7.4.2",
		"react": "19.3.1",
		"react-dom": "19.3.1"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.12",
		"@biomejs/biome": "2.6.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vite-pwa/assets-generator": "2.0.0",
		"fake-indexeddb": "6.2.6",
		"jsdom": "30.1.3",
		"typescript": "6.0.3",
		"vitest": "5.0.5",
		"vitest-axe": "0.1.0",
		"wrangler": "4.152.0"
	}
}
