---
import { type Locale, translator } from "../i18n"
import LanguageList from "./LanguageList.astro"

interface Props {
	locale: Locale
	path: string
}

// A disclosure of plain links, not an ARIA menu (spec §6, standard §6.1). The URL is the language.
// Behaviour comes from the vendored DS picker.js, imported once in Base; the list is LanguageList.
const { locale, path } = Astro.props
const { t, displayName } = translator(locale)
const name = `${t("picker.language")}: ${displayName(locale)}`
---

<nav class="lang" aria-label={t("picker.language")}>
	<details data-picker="lang">
		<summary class="has-tip tip-end tip-below">
			<svg
				class="lang-globe"
				viewBox="0 0 24 24"
				width="18"
				height="18"
				fill="none"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"
				aria-hidden="true"
			>
				<circle cx="12" cy="12" r="9"></circle>
				<path d="M3 12h18"></path>
				<path d="M12 3c2.5 2.6 3.7 5.6 3.7 9s-1.2 6.4-3.7 9c-2.5-2.6-3.7-5.6-3.7-9S9.5 5.6 12 3z"></path>
			</svg>
			<span class="visually-hidden">{name}</span>
			<span class="tip" aria-hidden="true">{t("picker.language")}</span>
		</summary>
		<LanguageList locale={locale} path={path} />
	</details>
</nav>
