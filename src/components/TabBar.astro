---
import { getRelativeLocaleUrl } from "astro:i18n"
import { type Locale, translator } from "../i18n"
import { TAB_PATHS, TABS, type Tab } from "../model/tabs"
import TabIcon from "./TabIcon.astro"

interface Props {
	locale: Locale
	/** The tab to mark with aria-current; null marks none. */
	current: Tab | null
	/** The page sits below the current tab (the Sources page under Tracker): the tab stays lit
	 *  but says "true", because it links to a different page (feedback spec §5). */
	sub?: boolean
}

// Bottom bar on phones, a text row under the header from 768 px (spec §5). Zero JavaScript.
const { locale, current, sub = false } = Astro.props
const { t } = translator(locale)
---

<nav class="tabbar" aria-label={t("nav.label")}>
	<ul>
		{
			TABS.map((id) => (
				<li>
					<a
						href={getRelativeLocaleUrl(locale, TAB_PATHS[id])}
						aria-current={id === current ? (sub ? "true" : "page") : undefined}
					>
						<TabIcon name={id} />
						<span>{t(`nav.${id}`)}</span>
					</a>
				</li>
			))
		}
	</ul>
</nav>
