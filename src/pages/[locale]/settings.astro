---
import { getRelativeLocaleUrl } from "astro:i18n"
import pkg from "../../../package.json"
import Chevron from "../../components/Chevron.astro"
import ExternalLink from "../../components/ExternalLink.astro"
import LanguageList from "../../components/LanguageList.astro"
import { isLocale, type Locale, locales, translator } from "../../i18n"
import Base from "../../layouts/Base.astro"
import { SITE } from "../../model/seo"
import { appVersion, commitUrl } from "../../model/version"

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale }, props: {} }))
}

// Settings acts on the whole device; per-profile export, import and delete stay in the Tracker's
// profile menu (spec §7).
const { locale } = Astro.params
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`)
const { t, displayName } = translator(locale as Locale)
// Read at render, so tests can stub it. A local build has no sha and shows "dev".
const sha = process.env.GITHUB_SHA
---

<Base locale={locale} title={t("seo.titles.settings")} description={t("settings.description")} path="settings">
	<h1>{t("settings.title")}</h1>

	<section class="settings-group" aria-labelledby="settings-general">
		<h2 id="settings-general">{t("settings.general")}</h2>
		{/* The header's picker as a row: choosing a language is a link, so nothing moves on its own
		    (WCAG 3.2.2). current-choice.ts swaps the value to System when no language is stored. */}
		<div class="rows">
			<details class="row-picker" data-picker="settings-lang">
				<summary class="row row-summary">
					<span class="row-label">{t("settings.language")}</span>
					<span class="row-value"><span data-choice-value>{displayName(locale as Locale)}</span><Chevron down /></span>
				</summary>
				<LanguageList locale={locale as Locale} path="settings" />
			</details>
		</div>
	</section>

	<section class="settings-group" aria-labelledby="settings-data">
		<h2 id="settings-data">{t("settings.data")}</h2>
		<dl class="rows">
			<div class="row">
				<dt>{t("settings.stored")}</dt>
				<dd>{t("settings.storedValue")}</dd>
			</div>
			<div class="row">
				<dt>{t("settings.languageChoice")}</dt>
				<dd>{t("settings.languageChoiceValue")}</dd>
			</div>
			<div class="row" data-storage-row data-yes={t("settings.yes")} data-no={t("settings.no")} hidden>
				<dt>{t("settings.persisted")}</dt>
				<dd data-value></dd>
			</div>
			<div class="row row-linked">
				<dt>{t("settings.transfer")}</dt>
				<dd><a href={getRelativeLocaleUrl(locale, "tracker")}>{t("settings.transferLink")}<Chevron /></a></dd>
			</div>
			<div class="row row-linked">
				<dt>{t("settings.privacy")}</dt>
				<dd><a href={getRelativeLocaleUrl(locale, "privacy")}>{t("settings.privacyLink")}<Chevron /></a></dd>
			</div>
		</dl>
	</section>

	<section id="about" class="settings-group" aria-labelledby="settings-about">
		<h2 id="settings-about">{t("settings.about")}</h2>
		<dl class="rows">
			<div class="row" data-install-row hidden>
				<dt>{t("settings.install")}</dt>
				<dd>
					<button type="button" class="row-button" data-install-button hidden>
						{t("settings.installButton")}
					</button>
					<span data-install-installed hidden>{t("settings.installed")}</span>
					<span data-install-ios hidden>{t("settings.iosHowTo")}</span>
				</dd>
			</div>
			<div class={sha ? "row row-linked" : "row"}>
				<dt>{t("settings.version")}</dt>
				<dd>
					{
						sha ? (
							<>
								{pkg.version} ·{" "}
								<span data-build-stamp>
									<ExternalLink href={commitUrl(sha)} locale={locale as Locale}>
										{sha.slice(0, 7)}
									</ExternalLink>
								</span>
							</>
						) : (
							appVersion(pkg.version, sha)
						)
					}
				</dd>
			</div>
			{/* Shown and wired by update-notice.ts once the service worker is registered. */}
			<div
				class="row"
				data-update-check
				data-checking={t("settings.checking")}
				data-current={t("settings.upToDate")}
				data-ready={t("settings.updateReady")}
				data-failed={t("settings.updateFailed")}
				hidden
			>
				<dt>{t("settings.updates")}</dt>
				<dd class="row-actions">
					<span class="row-status" role="status" data-update-check-status></span>
					<button type="button" class="row-button" data-update-check-button>
						{t("settings.checkUpdates")}
					</button>
				</dd>
			</div>
			<div
				class="row"
				data-share-row
				data-url={SITE}
				data-title={t("siteName")}
				data-text={t("tagline")}
				hidden
			>
				<dt>{t("settings.share")}</dt>
				<dd>
					<button type="button" class="row-button" data-share-button>{t("settings.shareButton")}</button>
				</dd>
			</div>
			<div class="row row-linked">
				<dt>{t("settings.feedback")}</dt>
				<dd><a href="mailto:feedback@rookdex.app"><span>feedback@<wbr />rookdex.app</span><Chevron /></a></dd>
			</div>
			<div class="row row-linked">
				<dt>{t("settings.source")}</dt>
				<dd>
					<ExternalLink href="https://github.com/rookdex/rookdex" locale={locale as Locale}>
						{t("settings.sourceLink")}
					</ExternalLink>
				</dd>
			</div>
			<div class="row">
				<dt>{t("settings.codeLicence")}</dt>
				<dd>MIT</dd>
			</div>
			<div class="row row-linked">
				<dt>{t("settings.guideLicence")}</dt>
				<dd>
					<ExternalLink
						href="https://creativecommons.org/licenses/by-sa/4.0/"
						locale={locale as Locale}
					>
						CC BY-SA 4.0
					</ExternalLink>
				</dd>
			</div>
			<div class="row row-linked">
				<dt>{t("settings.legal")}</dt>
				<dd><a href="mailto:legal@rookdex.app"><span>legal@<wbr />rookdex.app</span><Chevron /></a></dd>
			</div>
		</dl>
		<p class="note">{t("settings.trademarks")}</p>
	</section>

	<div id="delete-data" class="danger" data-delete>
		<p>{t("settings.dangerBody")}</p>
		<button type="button" class="danger-button" data-delete-open>{t("settings.deleteAll")}</button>
		<p class="delete-status" role="status" data-delete-status></p>
		<dialog
			class="modal"
			aria-labelledby="delete-all-title"
			data-blocked={t("settings.blocked")}
			data-failed={t("settings.failed")}
			data-done={t("settings.done")}
		>
			<h2 id="delete-all-title" tabindex="-1">{t("settings.dialogTitle")}</h2>
			<p>{t("settings.dangerBody")}</p>
			<p>{t("settings.keepsChoices")}</p>
			<p class="tracker-alert" role="alert" data-delete-alert></p>
			<div class="actions">
				<button type="button" data-delete-cancel>{t("settings.cancel")}</button>
				<button type="button" class="danger-button" data-delete-confirm>{t("settings.confirm")}</button>
			</div>
		</dialog>
	</div>
</Base>

<script>
	import { deleteAllData } from "../../scripts/delete-all"
	import { wireDeleteDialog, wireInstallRow, wireShareRow, wireStorageRow } from "../../scripts/settings"

	// Either store can be missing or throw on access (private modes, blocked site data).
	function database(): IDBFactory | undefined {
		try {
			return window.indexedDB ?? undefined
		} catch {
			return undefined
		}
	}

	const storageRow = document.querySelector<HTMLElement>("[data-storage-row]")
	if (storageRow) wireStorageRow(storageRow, navigator.storage)

	const installRow = document.querySelector<HTMLElement>("[data-install-row]")
	if (installRow) wireInstallRow(installRow, window)

	const shareRow = document.querySelector<HTMLElement>("[data-share-row]")
	if (shareRow) wireShareRow(shareRow, navigator)

	const danger = document.querySelector<HTMLElement>("[data-delete]")
	if (danger) {
		wireDeleteDialog(danger, (onBlocked) => deleteAllData(database(), onBlocked))
	}
</script>

<style>
	.settings-group {
		margin-bottom: var(--space-5);
	}

	.settings-group > h2 {
		margin: 0 0 var(--space-2);
		color: var(--text-muted);
		font-size: 0.8125rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.rows {
		margin: 0;
		padding: 0;
		list-style: none;
		background: var(--bg-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	/* Clips a row's hover fill to the list's rounded corners, so the separators stay straight. The
	   language list opens out of its card, so only the label and value lists clip. */
	dl.rows {
		overflow: hidden;
	}

	/* Muted label left, value or action right, the pattern phone settings screens use. */
	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		min-height: 48px;
		padding: 0 14px;
		font-size: 0.875rem;
	}

	.row:not([hidden]) ~ .row {
		border-top: 1px solid var(--border);
	}

	/* Label and value rows are a grid, so the value keeps its full width while it fits and the
	   label gives way first; with large text the value breaks instead of widening the page
	   (issue #28). */
	dl .row {
		display: grid;
		grid-template-columns: minmax(min-content, 1fr) auto;
	}

	.row dt,
	.row-label {
		color: var(--text-muted);
	}

	.row dd {
		margin: 0;
		color: var(--text);
		text-align: right;
		overflow-wrap: anywhere;
	}

	.row :global(a),
	.row-button {
		display: inline-flex;
		align-items: center;
		min-height: var(--tap);
	}

	.row :global(a) {
		gap: var(--space-1);
	}

	/* The margin keeps the 44 px button off the row lines above and below it. */
	.row-button {
		margin-block: var(--space-1);
		padding: 0 var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg);
		color: var(--text);
		font: inherit;
		cursor: pointer;
	}

	/* The status sits before its button and wraps above it when the row runs out of room. */
	.row-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-end;
		column-gap: var(--space-3);
	}

	/* Even padding, so the button stays centred on the label whether the status wraps or not. */
	.row-actions:has(.row-status:not(:empty)) {
		padding-block: var(--space-1);
	}

	.row-status {
		color: var(--text-muted);
	}

	.row-status:empty {
		display: none;
	}

	/* A row with one link: the link's box grows over the whole row, so the whole row is the
	   target, and the label stays outside the link's name. */
	.row-linked {
		position: relative;
		transition: background-color 120ms;
	}

	.row-linked :global(a::after) {
		content: "";
		position: absolute;
		inset: 0;
	}

	.row-linked :global(a:focus-visible) {
		outline: none;
	}

	.row-linked :global(a:focus-visible::after) {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}

	.row-linked:has(:global(a:focus-visible)) {
		background: var(--bg-hover);
	}

	.row :global(.row-chevron) {
		flex: none;
		width: 1rem;
		height: 1rem;
	}

	/* The language row: the header's picker list under a settings row. */
	.row-picker {
		position: relative;
	}

	.row-summary {
		list-style: none;
		cursor: pointer;
		border-radius: calc(var(--radius) - 1px);
		outline-offset: -2px;
		transition: background-color 120ms;
	}

	.row-summary::-webkit-details-marker {
		display: none;
	}

	.row-value {
		display: inline-flex;
		align-items: center;
		gap: var(--space-1);
		color: var(--link);
		text-align: right;
	}

	.row-picker[open] :global(.row-chevron) {
		rotate: 180deg;
	}

	.row-picker[open] > .row-summary,
	.row-summary:focus-visible {
		background: var(--bg-hover);
	}

	.danger {
		margin-top: var(--space-3);
		padding: var(--space-3);
		border: 1px solid var(--accent);
		border-radius: var(--radius);
	}

	.danger > p {
		color: var(--text-muted);
		font-size: 0.875rem;
	}

	/* Danger is the accent as an outline; filled pink stays for positive actions (plan decision 8). */
	.danger-button,
	.actions .danger-button {
		min-height: var(--tap);
		padding: 0 var(--space-3);
		border: 1px solid var(--accent);
		border-radius: var(--radius);
		background: transparent;
		color: var(--accent);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	.danger-button:disabled {
		opacity: 0.45;
		cursor: default;
	}

	.delete-status {
		margin: var(--space-2) 0 0;
	}

	/* Hover and focus lift (feedback spec §3.2). Here, not in global.css: these scoped rules load
	   after it and win every tie. */
	.row-button,
	.danger-button {
		transition:
			background-color 120ms,
			color 120ms;
	}

	@media (hover: hover) {
		.row-button:hover,
		.danger-button:not(:disabled):hover,
		.row-linked:hover,
		.row-summary:hover {
			background: var(--bg-hover);
		}
	}

	@media (hover: none) {
		.row-button:active,
		.danger-button:not(:disabled):active,
		.row-linked:active,
		.row-summary:active {
			background: var(--bg-hover);
		}
	}

	.row-button:focus-visible,
	.danger-button:not(:disabled):focus-visible {
		background: var(--bg-hover);
	}

	.note {
		margin: var(--space-2) 0 0;
		color: var(--text-muted);
		font-size: 0.8125rem;
	}
</style>
