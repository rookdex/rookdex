---
import { getRelativeLocaleUrl } from "astro:i18n"
import ChipNav from "../../../components/ChipNav.astro"
import { isLocale, type Locale, locales, seedLabel, translator } from "../../../i18n"
import { Tracker } from "../../../islands/Tracker"
import Base from "../../../layouts/Base.astro"
import { categoryIds, seedItems } from "../../../model/seed"

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale }, props: {} }))
}

const { locale } = Astro.params
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`)
const { t } = translator(locale as Locale)
const browse = categoryIds(seedItems.filter((item) => !item.retired)).map((id) => ({
	href: getRelativeLocaleUrl(locale as Locale, `dex/${id}`),
	label: seedLabel(t, "category", id),
}))
---

<Base locale={locale} title={t("seo.titles.tracker")} description={t("tracker.description")} path="tracker" trackerWide>
	<div class="tracker-head">
		<h1>{t("tracker.title")}</h1>
		<div id="tracker-profile"></div>
	</div>
	<noscript><p>{t("tracker.needsJs")}</p></noscript>
	<Tracker client:only="react" locale={locale}>
		<div slot="fallback" class="tracker-fallback"></div>
	</Tracker>
	{/* Server-rendered under the fallback's reserved height, so it adds no layout shift (category
	    pages spec §7). */}
	<div class="dex-browse">
		<ChipNav label={t("dex.browse")} headingId="dex-browse" chips={browse} />
	</div>
</Base>

<style>
	/* The island has no server HTML, so without this the footer paints right under the heading and
	   the tracker shoves it away on mount (CLS 0.22 at 320 px). Every filter, even the smallest,
	   renders taller than a screen, so one screen of reserve keeps the footer out of view throughout.
	   Without scripting the island never mounts, so the reserve would only be a gap. */
	.tracker-fallback {
		min-height: 100dvh;
	}

	@media (scripting: none) {
		.tracker-fallback {
			min-height: 0;
		}
	}

	.dex-browse {
		margin-top: var(--space-5);
	}

	/* The title row (tracker refresh spec §5.5): the h1 left, the island portals the profile button
	   into the slot on the right. The slot is at the edge, so the button's arrival moves nothing,
	   and min-height holds its 44 px before the island mounts. */
	.tracker-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--space-3);
		min-height: var(--tap);
		margin-bottom: var(--space-3);
	}

	/* The title never shrinks or breaks; a long profile name ellipses instead. */
	.tracker-head h1 {
		flex: none;
		margin: 0;
	}

	/* 62 px holds the avatar-only button (8 + 28 + 8 + 12 + 2 border). When the title and that floor
	   do not fit on one line (320 px at 200 % text), the slot wraps under the title, right-aligned. */
	#tracker-profile {
		display: flex;
		flex: 1 1 0;
		justify-content: flex-end;
		min-width: 62px;
		min-height: var(--tap);
	}

	/* Centred at the tracker's own cap (global.css), so the title shares the search row's left edge.
	   Here rather than a :has(.tracker) rule, which would only match after the island mounts. The
	   Browse row keeps the same cap. */
	@media (min-width: 1024px) {
		.tracker-head,
		.dex-browse {
			max-width: var(--tracker-max-w);
			margin-inline: auto;
		}
	}
</style>
