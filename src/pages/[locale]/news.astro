---
import { getCollection } from "astro:content"
import { getRelativeLocaleUrl } from "astro:i18n"
import AllSources from "../../components/AllSources.astro"
import ExternalLink from "../../components/ExternalLink.astro"
import { defaultLocale, isLocale, type Locale, locales, translator } from "../../i18n"
import {
	AtIcon,
	CameraIcon,
	guideIcon,
	ImageIcon,
	NewspaperIcon,
	PlayIcon,
} from "../../islands/tracker/icons"
import Base from "../../layouts/Base.astro"
import { latestRumours, newestFacts } from "../../model/dashboard"
import { newsDate } from "../../model/days"
import { guideSlugs, resolveGuide } from "../../model/guides"
import { outletOf } from "../../model/outlet"
import { facts, rumours } from "../../model/seed"

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale }, props: {} }))
}

// The News tab (spec §8). Confirmed facts sit above the rumours. Both are hand-curated until the
// phase 1c facts feed takes over.
const { locale } = Astro.params
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`)
const { t } = translator(locale as Locale)
// Newest first, the same order as Latest on the hub (dashboard spec §6.3).
const ordered = latestRumours(rumours, rumours.length)
const confirmed = newestFacts(facts)
const lang = locale as Locale
// Dates are fixed at build time; a date from another year shows its year (News redesign spec §3).
const buildYear = new Date().getUTCFullYear()
// Rockstar's own channels, as its site footer links them. Muted icons of my own, no logos.
const channels = [
	{
		name: "Rockstar Newswire",
		href: "https://www.rockstargames.com/newswire",
		Icon: NewspaperIcon,
	},
	// Rockstar's media page, linked and never mirrored: no Rockstar art on Rookdex.
	{ name: t("channels.media"), href: "https://www.rockstargames.com/VI/media", Icon: ImageIcon },
	{ name: "YouTube", href: "https://www.youtube.com/@RockstarGames", Icon: PlayIcon },
	{ name: "X", href: "https://x.com/rockstargames", Icon: AtIcon },
	{ name: "Instagram", href: "https://instagram.com/rockstargames", Icon: CameraIcon },
]
// The launch guides head the aside, so a first-timer finds the checklist beside the news.
const guideEntries = await getCollection("guides")
const guides = guideSlugs(guideEntries)
	.sort()
	.map((slug) => {
		const found = resolveGuide(guideEntries, locale, slug, defaultLocale)
		if (!found) throw new Error(`Missing guide: ${slug}`)
		return {
			href: getRelativeLocaleUrl(locale, `guides/${slug}`),
			Icon: guideIcon(slug),
			...found.entry.data,
		}
	})
---

<Base locale={locale} title={t("seo.titles.news")} description={t("news.description")} path="news">
	<article class="news">
		<h1>{t("news.title")}</h1>
		{
			confirmed.length > 0 && (
				<section aria-labelledby="confirmed">
					<h2 id="confirmed">{t("facts.title")}</h2>
					<p class="section-intro">{t("facts.intro")}</p>
					<ul class="rumour-list fact-list">
						{confirmed.map((fact, index) => {
							const official =
								fact.sources.find((source) => source.tier === "official") ?? fact.sources[0]
							return (
								<li class:list={{ "is-lead": index === 0 }}>
									<h3>{fact.name[lang]}</h3>
									<p class="tier-line">
										<span class="tier-dot is-confirmed" aria-hidden="true" />
										<span class="tier-label">{t("facts.title")}</span>
										<time datetime={fact.announced}>
											{newsDate(fact.announced, lang, buildYear)}
										</time>
									</p>
									<p class="summary">{fact.summary[lang]}</p>
									<p class="meta">
										<ExternalLink href={official.url} locale={lang}>
											{t("facts.announcedOn", { outlet: outletOf(official.url) })}
										</ExternalLink>
									</p>
									<AllSources
										sources={fact.sources}
										label={t("news.allSources", { count: String(fact.sources.length) })}
										locale={lang}
									/>
								</li>
							)
						})}
					</ul>
				</section>
			)
		}
		<section aria-labelledby="rumours">
			<h2 id="rumours">{t("rumours.title")}</h2>
			<p class="section-intro">{t("rumours.intro")}</p>
			{
				ordered.length === 0 ? (
					<p>{t("rumours.empty")}</p>
				) : (
					<ul class="rumour-list">
						{ordered.map((rumour) => {
							const press =
								rumour.sources.find((source) => source.tier === "press") ?? rumour.sources[0]
							return (
								<li>
									<h3>{rumour.name}</h3>
									<p class="tier-line">
										<span class="tier-dot is-rumour" aria-hidden="true" />
										<span class="tier-label">{t("hub.chipRumour")}</span>
										<time datetime={rumour.added}>{newsDate(rumour.added, lang, buildYear)}</time>
									</p>
									<p class="summary">{rumour.summary}</p>
									<p class="meta">
										<ExternalLink href={press.url} locale={locale as Locale}>
											{t("rumours.reportedBy", { outlet: outletOf(press.url) })}
										</ExternalLink>
									</p>
									<AllSources
										sources={rumour.sources}
										label={t("news.allSources", { count: String(rumour.sources.length) })}
										locale={locale as Locale}
									/>
								</li>
							)
						})}
					</ul>
				)
			}
		</section>
		<aside class="news-aside">
			<section class="news-panel" aria-labelledby="new-to-gta">
				<h2 id="new-to-gta">{t("newsGuides.title")}</h2>
				<p class="section-intro">{t("newsGuides.intro")}</p>
				<ul class="panel-list">
					{
						guides.map(({ href, title, Icon }) => (
							<li>
								<a href={href}>
									<Icon />
									<span class="row-label">{title}</span>
									<span class="row-arrow" aria-hidden="true">
										›
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</section>
			<section class="news-panel" aria-labelledby="channels">
				<h2 id="channels">{t("channels.title")}</h2>
				<p class="section-intro">{t("channels.intro")}</p>
				<ul class="panel-list">
					{
						channels.map(({ name, href, Icon }) => (
							<li>
								<ExternalLink href={href} locale={lang}>
									<Icon />
									<span class="row-label">{name}</span>
								</ExternalLink>
							</li>
						))
					}
				</ul>
			</section>
		</aside>
	</article>
</Base>

<style>
	/* Each section says where its items come from, so a confirmed fact never sits under the
	   "not confirmed" line. Muted like the summaries, at body size. */
	.section-intro {
		color: var(--text-muted);
	}

	/* The side panels (News redesign spec §4): rows split by hairlines, no boxes. Each row is one
	   full-width link, set apart by its icon and arrow, so it drops the running-text underline
	   and shows it on hover and focus instead. :global(a) reaches into ExternalLink. */
	.panel-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.panel-list li + li {
		border-top: 1px solid var(--border);
	}

	.panel-list :global(a) {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: var(--tap);
		padding-block: var(--space-1);
		text-decoration: none;
	}

	.panel-list :global(a > svg:first-child) {
		flex: none;
		color: var(--text-muted);
	}

	.panel-list :global(a:focus-visible) {
		text-decoration: underline;
	}

	@media (hover: hover) {
		.panel-list :global(a:hover) {
			text-decoration: underline;
		}
	}

	.row-label {
		flex: 1 1 auto;
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.row-arrow {
		color: var(--text-muted);
	}

	section + section {
		margin-top: var(--space-4);
	}
</style>
