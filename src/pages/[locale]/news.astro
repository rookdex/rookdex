---
import { getCollection } from "astro:content"
import { getRelativeLocaleUrl } from "astro:i18n"
import AllSources from "../../components/AllSources.astro"
import ExternalLink from "../../components/ExternalLink.astro"
import { defaultLocale, isLocale, type Locale, locales, translator } from "../../i18n"
import {
	ArrowDownIcon,
	AtIcon,
	CameraIcon,
	ChecklistIcon,
	guideIcon,
	ImageIcon,
	NewspaperIcon,
	PlayIcon,
} from "../../islands/tracker/icons"
import Base from "../../layouts/Base.astro"
import { latestRumours, newestFacts } from "../../model/dashboard"
import { newsDate } from "../../model/days"
import { guideSlugs, resolveGuide } from "../../model/guides"
import { outletOf } from "../../model/outlet"
import { facts, rumours } from "../../model/seed"

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale }, props: {} }))
}

// The News tab (spec §8). Confirmed facts sit above the rumours. Both are hand-curated until the
// phase 1c facts feed takes over.
const { locale } = Astro.params
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`)
const { t, plural } = translator(locale as Locale)
// Newest first, the same order as Latest on the hub (dashboard spec §6.3).
const ordered = latestRumours(rumours, rumours.length)
const confirmed = newestFacts(facts)
const lang = locale as Locale
// Dates are fixed at build time; a date from another year shows its year (News redesign spec §3).
const buildYear = new Date().getUTCFullYear()
// Rockstar's own channels, as its site footer links them. Muted icons of my own, no logos.
const channels = [
	{
		name: "Rockstar Newswire",
		href: "https://www.rockstargames.com/newswire",
		Icon: NewspaperIcon,
	},
	// Rockstar's media page, linked and never mirrored: no Rockstar art on Rookdex.
	{ name: t("channels.media"), href: "https://www.rockstargames.com/VI/media", Icon: ImageIcon },
	{ name: "YouTube", href: "https://www.youtube.com/@RockstarGames", Icon: PlayIcon },
	{ name: "X", href: "https://x.com/rockstargames", Icon: AtIcon },
	{ name: "Instagram", href: "https://instagram.com/rockstargames", Icon: CameraIcon },
]
// The launch guides head the aside, so a first-timer finds the checklist beside the news.
const guideEntries = await getCollection("guides")
const guides = guideSlugs(guideEntries)
	.sort()
	.map((slug) => {
		const found = resolveGuide(guideEntries, locale, slug, defaultLocale)
		if (!found) throw new Error(`Missing guide: ${slug}`)
		return {
			href: getRelativeLocaleUrl(locale, `guides/${slug}`),
			Icon: guideIcon(slug),
			...found.entry.data,
		}
	})
---

<Base locale={locale} title={t("seo.titles.news")} description={t("news.description")} path="news" wide>
	<article class="news">
		<h1>{t("news.title")}</h1>
		<nav class="news-jump" aria-labelledby="news-jump-label">
			<p class="tile-label" id="news-jump-label">{t("news.jumpLabel")}</p>
			<ul class="panel-list">
				{
					[
						{
							href: "#new-to-gta",
							Icon: ChecklistIcon,
							title: t("newsGuides.title"),
							count: plural("news.jumpGuides", guides.length),
						},
						{
							href: "#channels",
							Icon: NewspaperIcon,
							title: t("channels.title"),
							count: plural("news.jumpChannels", channels.length),
						},
					].map(({ href, Icon, title, count }) => (
						<li>
							<a href={href}>
								<Icon />
								<span class="row-label">
									<span class="row-title">{title}</span>{" "}
									<span class="row-count">{count}</span>
								</span>
								<span class="row-arrow">
									<ArrowDownIcon />
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class:list={["news-grid", { "no-facts": confirmed.length === 0 }]}>
			{
				confirmed.length > 0 && (
					<section class="news-confirmed" aria-labelledby="confirmed">
						<h2 id="confirmed">{t("facts.title")}</h2>
						<p class="section-intro">{t("facts.intro")}</p>
						<ul class="rumour-list fact-list">
							{confirmed.map((fact, index) => {
								const official =
									fact.sources.find((source) => source.tier === "official") ?? fact.sources[0]
								return (
									<li class:list={{ "is-lead": index === 0 }}>
										<h3>{fact.name[lang]}</h3>
										<p class="tier-line">
											<span class="news-chip is-confirmed">{t("facts.title")}</span>
											{" "}
											<time datetime={fact.announced}>
												{newsDate(fact.announced, lang, buildYear)}
											</time>
										</p>
										<p class="summary">{fact.summary[lang]}</p>
										<p class="meta">
											<ExternalLink href={official.url} locale={lang}>
												{t("facts.announcedOn", { outlet: outletOf(official.url) })}
											</ExternalLink>
										</p>
										<AllSources
											sources={fact.sources}
											label={t("news.allSources", { count: String(fact.sources.length) })}
											locale={lang}
										/>
									</li>
								)
							})}
						</ul>
					</section>
				)
			}
			<section class="news-rumours" aria-labelledby="rumours">
				<h2 id="rumours">{t("rumours.title")}</h2>
				<p class="section-intro">{t("rumours.intro")}</p>
				{
					ordered.length === 0 ? (
						<p>{t("rumours.empty")}</p>
					) : (
						<ul class="rumour-list">
							{ordered.map((rumour) => {
								const press =
									rumour.sources.find((source) => source.tier === "press") ?? rumour.sources[0]
								return (
									<li>
										<h3>{rumour.name}</h3>
										<p class="tier-line">
											<span class="news-chip is-rumour">{t("hub.chipRumour")}</span>
											{" "}
											<time datetime={rumour.added}>{newsDate(rumour.added, lang, buildYear)}</time>
										</p>
										<p class="summary">{rumour.summary}</p>
										<p class="meta">
											<ExternalLink href={press.url} locale={locale as Locale}>
												{t("rumours.reportedBy", { outlet: outletOf(press.url) })}
											</ExternalLink>
										</p>
										<AllSources
											sources={rumour.sources}
											label={t("news.allSources", { count: String(rumour.sources.length) })}
											locale={locale as Locale}
										/>
									</li>
								)
							})}
						</ul>
					)
				}
			</section>
			<aside class="news-aside">
				<section class="news-panel" aria-labelledby="new-to-gta">
					<h2 id="new-to-gta">{t("newsGuides.title")}</h2>
					<p class="section-intro">{t("newsGuides.intro")}</p>
					<ul class="panel-list">
						{
							guides.map(({ href, title, Icon }) => (
								<li>
									<a href={href}>
										<Icon />
										<span class="row-label">{title}</span>
										<span class="row-arrow" aria-hidden="true">
											›
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</section>
				<section class="news-panel" aria-labelledby="channels">
					<h2 id="channels">{t("channels.title")}</h2>
					<p class="section-intro">{t("channels.intro")}</p>
					<ul class="panel-list">
						{
							channels.map(({ name, href, Icon }) => (
								<li>
									<ExternalLink href={href} locale={lang}>
										<Icon />
										<span class="row-label">{name}</span>
									</ExternalLink>
								</li>
							))
						}
					</ul>
				</section>
			</aside>
		</div>
	</article>
</Base>

<style>
	/* Each section says where its items come from, so a confirmed fact never sits under the
	   "not confirmed" line. Muted like the summaries, at body size. */
	.section-intro {
		color: var(--text-muted);
	}

	/* The side panels (News redesign spec §4): one tile each, like the dashboard tiles, with rows
	   split by hairlines. */
	.news-panel {
		padding: var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-raised);
	}

	.news-panel h2 {
		margin-top: 0;
		font-size: 1.125rem;
	}

	.news-panel .section-intro {
		font-size: 0.875rem;
	}

	/* Each row is one full-width link, set apart by its icon and arrow, so it drops the
	   running-text underline and shows it on hover and focus instead. White labels with muted
	   marks: cyan stays for moving around the site. The icon and arrow sit on the first line of
	   a label that wraps: the padding keeps a one-line row at 44 px, and the 22 px icon drops
	   half the gap to its line, at any text size. :global(a) reaches into ExternalLink. */
	.panel-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.panel-list li + li {
		border-top: 1px solid var(--border);
	}

	.panel-list :global(a) {
		display: flex;
		align-items: flex-start;
		gap: var(--space-3);
		min-height: var(--tap);
		padding-block: max(var(--space-1), (var(--tap) - 1lh) / 2);
		color: var(--text);
		text-decoration: none;
	}

	.panel-list :global(a > svg:first-child) {
		flex: none;
		margin-top: calc((1lh - 22px) / 2);
		color: var(--text-muted);
	}

	/* The ↗ is 0.8em tall; the same half-gap drop puts it on the first line. */
	.panel-list :global(.ext-icon) {
		flex: none;
		margin-top: calc((1lh - 0.8em) / 2);
		color: var(--text-muted);
	}

	.panel-list :global(a:focus-visible) {
		text-decoration: underline;
	}

	@media (hover: hover) {
		.panel-list :global(a:hover) {
			text-decoration: underline;
		}
	}

	.row-label {
		flex: 1 1 auto;
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.row-arrow {
		color: var(--text-muted);
	}

	/* The jump tile (News redesign spec §2, feedback round 2): below 1024 px the panels sit at the
	   end of the page, so a tile under the h1 names both and says how much is behind each. Its rows
	   are panel rows (.panel-list above); the ↓ says the jump stays on this page. */
	.news-jump {
		margin: 0 0 var(--space-5);
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--bg-raised);
	}

	.news-jump .tile-label {
		margin: var(--space-2) 0 var(--space-1);
	}

	.row-title {
		font-family: var(--font-heading);
		font-weight: 600;
	}

	.row-count {
		font-size: 0.875rem;
		color: var(--text-muted);
		white-space: nowrap;
	}

	/* 18 px, dropped onto the first line like the ↗ in the channel rows. */
	.news-jump .row-arrow {
		flex: none;
		display: flex;
		margin-top: calc((1lh - 18px) / 2);
	}

	.news-jump .row-arrow :global(svg) {
		width: 18px;
		height: 18px;
	}

	/* Air and a hairline between the tile and the news, so the tile reads as part of the page head
	   and Confirmed starts a new block. */
	.news-jump + .news-grid {
		padding-top: var(--space-5);
		border-top: 1px solid var(--border);
	}

	/* Layout per screen size (News redesign spec §2). One column below 1024 px; news and panels
	   side by side from 1024 px; Confirmed, Rumours and panels in three columns from 1600 px. */

	/* --space-4 between the boxes, as between the dashboard tiles. */
	.news-grid {
		display: grid;
		gap: var(--space-4);
	}

	.news-grid > * {
		min-width: 0;
	}

	.news-aside {
		display: grid;
		gap: var(--space-4);
		align-content: start;
	}

	/* The two panels sit side by side at the end of the single column. */
	@media (min-width: 768px) {
		.news-aside {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Not sticky: both panels are short, and a sticky column overlaps the footer at 200 % text.
	   The jump tile and its hairline go, because the panels are in view. Extra height from the aside goes to
	   the Rumours row, so Confirmed and Rumours never drift apart. */
	@media (min-width: 1024px) {
		.news-jump {
			display: none;
		}

		.news-jump + .news-grid {
			padding-top: 0;
			border-top: 0;
		}

		/* Each section's h2, intro and card list sit on three shared rows (subgrid), so the first
		   cards line up across columns even when one intro wraps to two lines, and the aside starts
		   on the card row. The row gap is 0 because the subgrids set their own spacing. */
		.news-grid {
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
			grid-template-rows: repeat(5, auto) 1fr;
			grid-template-areas:
				"confirmed ."
				"confirmed ."
				"confirmed aside"
				"rumours aside"
				"rumours aside"
				"rumours aside";
			row-gap: 0;
			align-items: start;
		}

		.news-grid.no-facts {
			grid-template-rows: auto auto 1fr;
			grid-template-areas:
				"rumours ."
				"rumours ."
				"rumours aside";
		}

		.news-confirmed,
		.news-rumours {
			display: grid;
			grid-template-rows: subgrid;
			row-gap: 0;
			align-self: stretch;
		}

		.news-confirmed > *,
		.news-rumours > * {
			align-self: start;
		}

		.news-confirmed {
			grid-area: confirmed;
		}

		.news-rumours {
			grid-area: rumours;
		}

		/* Stacked under Confirmed, Rumours keeps the --space-4 the grid gap gave it. */
		.news-confirmed + .news-rumours {
			margin-top: var(--space-4);
		}

		.news-aside {
			grid-area: aside;
			grid-template-columns: minmax(0, 1fr);
		}
	}

	/* Text stops at --measure, so a third column beats a wide news column with an empty strip. */
	@media (min-width: 1600px) {
		.news-grid {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 0.75fr);
			grid-template-rows: auto auto 1fr;
			grid-template-areas:
				"confirmed rumours ."
				"confirmed rumours ."
				"confirmed rumours aside";
		}

		.news-confirmed + .news-rumours {
			margin-top: 0;
		}

		/* No facts: Rumours takes the first slot and the page keeps two columns, so no column
		   stands empty. */
		.news-grid.no-facts {
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
			grid-template-areas:
				"rumours ."
				"rumours ."
				"rumours aside";
		}
	}
</style>
