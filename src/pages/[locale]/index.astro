---
import { getRelativeLocaleUrl } from "astro:i18n"
import Mark from "../../components/Mark.astro"
import { isLocale, type Locale, locales, t } from "../../i18n"
import { Countdown } from "../../islands/Countdown"
import { InstallPrompt } from "../../islands/InstallPrompt"
import Base from "../../layouts/Base.astro"

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`)
const s = t(locale as Locale)
---

<Base locale={locale} title={s.siteName} description={s.tagline} path="">
	<div class="hub">
		<header class="hub-intro">
			<h1 class="lockup" aria-label="Rookdex">
				<Mark id="hub" size={48} />
				<span class="wordmark">ROOKDEX</span>
			</h1>
			<p class="tagline">{s.tagline}</p>
			<p class="tap-links">
				<a href={getRelativeLocaleUrl(locale, "tracker")}>{s.hub.openTracker}</a>
			</p>
		</header>
		<Countdown
			client:load
			locale={locale}
			initialNow={new Date().toISOString()}
			guideHref={getRelativeLocaleUrl(locale, "guides/before-you-start")}
			trackerHref={getRelativeLocaleUrl(locale, "tracker")}
		/>
	</div>
	<InstallPrompt client:idle locale={locale} />
</Base>
