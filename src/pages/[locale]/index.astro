---
import { getCollection } from "astro:content"
import { getRelativeLocaleUrl } from "astro:i18n"
import Mark from "../../components/Mark.astro"
import { MAP_LINK } from "../../config/map-link"
import { defaultLocale, isLocale, type Locale, locales, translator } from "../../i18n"
import { Hub } from "../../islands/hub/Hub"
import { LATEST_LIMIT, NEWS_LIMIT } from "../../islands/hub/limits"
import { InstallPrompt } from "../../islands/InstallPrompt"
import Base from "../../layouts/Base.astro"
import { buildNow } from "../../model/build-now"
import { categoryRows, latestNews, latestRumours } from "../../model/dashboard"
import { resolveGuide } from "../../model/guides"
import { facts, rumours, seedItems } from "../../model/seed"
import { countable } from "../../model/stats"

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }))
}

const { locale } = Astro.params
if (!isLocale(locale)) throw new Error(`Unknown locale: ${locale}`)
const { t } = translator(locale as Locale)
// Read at build time only; production never sets ROOKDEX_NOW (dashboard spec §6.4, §11).
const initialNow = buildNow(process.env.ROOKDEX_NOW).toISOString()
const latest = latestRumours(rumours, LATEST_LIMIT).map(({ id, name, added }) => ({
	id,
	name,
	added,
}))
const guides = await getCollection("guides")
const guideTitle = (slug: string) => {
	const found = resolveGuide(guides, locale, slug, defaultLocale)
	if (!found) throw new Error(`Missing guide: ${slug}`)
	return found.entry.data.title
}
const categories = categoryRows(countable(seedItems), {})
const news = latestNews(facts, rumours, NEWS_LIMIT).map(({ id, kind, date, name }) => ({
	id,
	kind,
	date,
	name: typeof name === "string" ? name : name[locale as Locale],
}))
---

<Base locale={locale} title={t("seo.titles.home")} description={t("seo.homeDescription")} path="" wide>
	<div class="hub">
		<header class="hub-intro">
			<h1 class="lockup" aria-label={t("siteName")}>
				<Mark id="hub" size={48} />
				<span class="wordmark">ROOKDEX</span>
			</h1>
			<p class="tagline">{t("tagline")}</p>
			<p class="tap-links">
				<a class="go-link" href={getRelativeLocaleUrl(locale, "tracker")}>{t("hub.openTracker")}</a>
			</p>
		</header>
		{/* The server-rendered time changes every build; the version hash skips it (precache.mjs). */}
		<div class="build-stamp" data-build-stamp>
			<Hub
				client:load
				locale={locale}
				initialNow={initialNow}
				guideHref={getRelativeLocaleUrl(locale, "guides/before-you-start")}
				trackerHref={getRelativeLocaleUrl(locale, "tracker")}
				newsHref={getRelativeLocaleUrl(locale, "news")}
				latest={latest}
				categories={categories}
				news={news}
				mapLink={MAP_LINK.url}
				settingsHref={getRelativeLocaleUrl(locale, "settings")}
				firstHourHref={getRelativeLocaleUrl(locale, "guides/first-hour")}
				guideTitle={guideTitle("before-you-start")}
				firstHourTitle={guideTitle("first-hour")}
			/>
		</div>
	</div>
	<InstallPrompt client:idle locale={locale} />
</Base>
